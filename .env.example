# Cấu hình kết nối Cơ sở dữ liệu đồ thị Neo4j
# Có thể dùng Neo4j Desktop / Local Server hoặc Neo4j AuraDB (Cloud)

# 1. Trường hợp dùng Neo4j Local / Desktop (Mặc định)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# 2. Trường hợp dùng Neo4j AuraDB Cloud (Miễn phí)
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_aura_generated_password
# NEO4J_DATABASE=neo4j
